# Shared defaults for local development.
# Copy to each app's directory, e.g. versions/v01-login-and-code/server/.env

# Authorization server
# Ports 25000/25001 avoid macOS AirPlay claiming :5000.
AUTH_SERVER_URL=http://localhost:25000
AUTH_SERVER_PORT=25000

# OAuth client app
CLIENT_APP_URL=http://localhost:25001
CLIENT_APP_PORT=25001

# OAuth client registration (you will use these when wiring the flow)
CLIENT_ID=demo-client
CLIENT_SECRET=demo-secret
REDIRECT_URI=http://localhost:25001/callback

# Flask session signing (generate your own for local dev)
# Client and server may share SECRET_KEY; session cookie names are set per app in app.py.
SECRET_KEY=change-me-to-a-random-string

# v06 — resource server (copy .env into auth-server/, resource-server/, and client/)
RESOURCE_SERVER_URL=http://localhost:25002
RESOURCE_SERVER_PORT=25002

# v06 — token format and validation (must match across all three apps)
# Mode A: opaque + introspection (default)
ACCESS_TOKEN_FORMAT=opaque
TOKEN_VALIDATION=introspection
# Mode B: jwt + local verify — set both to jwt and set JWT_SECRET
# ACCESS_TOKEN_FORMAT=jwt
# TOKEN_VALIDATION=jwt
JWT_SECRET=change-me-to-a-random-string

# v06 — service client credentials for POST /introspect (auth-server memory.service_clients)
INTROSPECTION_CLIENT_ID=resource-server
INTROSPECTION_CLIENT_SECRET=resource-secret
